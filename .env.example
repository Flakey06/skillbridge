# Copy this file to .env. Never commit the real .env file.

# Stripe test-mode secret key. Must start with sk_test_.
STRIPE_SECRET_KEY=sk_test_replace_me

# Optional: use a recurring Stripe test Price instead of the inline price.
STRIPE_PRICE_ID=

# Stripe webhook signing secret from `stripe listen` or the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Pro price in the smallest currency unit: 900 = S$9.00 per month.
PRO_PLAN_AMOUNT_CENTS=900
PRO_PLAN_CURRENCY=sgd

# Optional LinkedIn organisation lookup access.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=202601

# Optional: verifies Accredible credentials through the official API.
ACCREDIBLE_API_KEY=

# Password recovery email. Console prints reset links in the server terminal.
# To deliver email, use django.core.mail.backends.smtp.EmailBackend and your provider's settings.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@skillbridge.local
